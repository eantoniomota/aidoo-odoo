<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_aidoo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.aidoo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Aidoo" string="Aidoo" name="aidoo" groups="aidoo.group_aidoo_admin">
                    <block title="Aidoo connection" name="aidoo_connection">
                        <setting id="aidoo_connection_setting"
                                 string="Aidoo connection key"
                                 help="Paste the connection key generated on your Aidoo dashboard.">
                            <div class="content-group">
                                <div class="row mt8" invisible="aidoo_api_key_set">
                                    <span class="text-warning">
                                        <i class="fa fa-warning"/>
                                        This Odoo is not connected to Aidoo yet.
                                    </span>
                                </div>
                                <div class="row mt8" invisible="not aidoo_api_key_set">
                                    <span class="text-success">
                                        <i class="fa fa-check"/>
                                        Connected to Aidoo.
                                    </span>
                                </div>

                                <div class="row mt16">
                                    <label for="aidoo_manual_api_key" class="col-3 o_light_label"/>
                                    <field name="aidoo_manual_api_key" password="True"
                                           placeholder="aid_odoo_prod_..."/>
                                </div>

                                <div class="row mt8">
                                    <div class="col-12">
                                        <span class="text-muted">
                                            <i class="fa fa-info-circle"/>
                                            Generate a key at
                                            <a href="https://aidoo.fr" target="_blank">aidoo.fr</a>
                                            → Settings → Odoo module.
                                        </span>
                                    </div>
                                </div>

                                <div class="row mt16" invisible="not aidoo_api_key_set">
                                    <button name="action_aidoo_disconnect" type="object"
                                            string="Disconnect" class="btn-link"
                                            confirm="Disconnect this Odoo from Aidoo? Users will no longer see the Aidoo systray."/>
                                </div>
                            </div>
                        </setting>

                        <setting id="aidoo_language_setting"
                                 string="Interface language"
                                 help="Language used for the Aidoo systray and panels.">
                            <div class="content-group">
                                <div class="row">
                                    <label for="aidoo_user_lang" class="col-3 o_light_label"/>
                                    <field name="aidoo_user_lang"/>
                                </div>
                                <div class="row mt8">
                                    <div class="col-12">
                                        <button name="action_aidoo_reload_translations"
                                                type="object"
                                                string="Reload translations"
                                                class="btn-link"
                                                confirm="Reload Aidoo translations for every active language? You will need to refresh the page after."/>
                                        <span class="text-muted small ms-2">
                                            Use this if the interface stays in English after a language change.
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </setting>

                        <setting id="aidoo_advanced_setting"
                                 string="Advanced"
                                 help="Override the Aidoo API base URL (self-hosted instances only).">
                            <div class="content-group">
                                <div class="row">
                                    <label for="aidoo_api_base_url" class="col-3 o_light_label"/>
                                    <field name="aidoo_api_base_url"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
