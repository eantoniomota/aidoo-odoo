<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_aidoo" model="ir.module.category">
        <field name="name">Aidoo</field>
        <field name="description">Aidoo AI assistant integration</field>
        <field name="sequence">85</field>
    </record>

    <record id="group_aidoo_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_aidoo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_aidoo_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_aidoo"/>
        <field name="implied_ids" eval="[(4, ref('group_aidoo_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
