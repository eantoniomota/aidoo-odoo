<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aidoo.Systray">
        <div t-if="state.visible" class="o_menu_systray_item dropdown o-aidoo-systray">
            <button type="button"
                    class="btn o-aidoo-trigger"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    aria-expanded="false"
                    aria-label="Aidoo"
                    title="Aidoo">
                <img src="/aidoo/static/description/icon.png"
                     alt="Aidoo"
                     class="o-aidoo-logo"/>
            </button>
            <div class="dropdown-menu dropdown-menu-end o-aidoo-dropdown">
                <AidooPanel/>
            </div>
        </div>
    </t>

</templates>
