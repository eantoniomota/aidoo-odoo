<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aidoo.Panel">
        <div class="o-aidoo-panel" style="min-width: 360px; max-width: 480px;">

            <t t-if="state.loading">
                <div class="p-4 text-center text-muted">
                    <i class="fa fa-circle-o-notch fa-spin me-1"/>
                    <span t-esc="labels.loading"/>
                </div>
            </t>

            <t t-elif="currentState === 'no_token'">
                <AidooNoToken isAdmin="state.boot?.isAdmin" signupUrl="state.boot?.signupUrl"/>
            </t>

            <t t-elif="currentState === 'invited'">
                <AidooInvited email="email" signupUrl="state.resolved?.signupUrl"/>
            </t>

            <t t-elif="currentState === 'mapped_no_claude'">
                <AidooNoClaude mcpUrl="state.resolved?.mcpUrl"/>
            </t>

            <t t-elif="currentState === 'mapped'">
                <div class="o-aidoo-header p-2 d-flex align-items-center border-bottom">
                    <span class="fw-bold me-2">Aidoo</span>
                    <small class="text-muted text-truncate flex-grow-1 me-2"
                           t-esc="state.resolved.user.firstName + ' ' + state.resolved.user.lastName"/>
                    <button type="button"
                            class="btn btn-sm btn-primary flex-shrink-0"
                            t-on-click="openClaude"
                            t-att-title="labels.openClaude">
                        <i class="fa fa-external-link me-1"/>
                        <span t-esc="labels.openClaude"/>
                    </button>
                </div>

                <ul class="nav nav-tabs px-2 pt-2" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link"
                                t-att-class="{ 'active': state.tab === 'executions' }"
                                t-on-click="() => this.selectTab('executions')"
                                t-esc="labels.tabExecutions"/>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link"
                                t-att-class="{ 'active': state.tab === 'workflows' }"
                                t-on-click="() => this.selectTab('workflows')"
                                t-esc="labels.tabWorkflows"/>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link"
                                t-att-class="{ 'active': state.tab === 'claude' }"
                                t-on-click="() => this.selectTab('claude')"
                                t-esc="labels.tabClaude"/>
                    </li>
                </ul>

                <div class="o-aidoo-tab-content p-2">
                    <t t-if="state.tab === 'executions'">
                        <ExecutionsTab context="state.context"/>
                    </t>
                    <t t-elif="state.tab === 'workflows'">
                        <WorkflowsTab context="state.context"/>
                    </t>
                    <t t-elif="state.tab === 'claude'">
                        <ClaudeTab mcpUrl="state.resolved?.mcpUrl"/>
                    </t>
                </div>
            </t>

            <t t-else="">
                <div class="o-aidoo-empty p-3 text-center text-muted">
                    <i class="fa fa-circle-o-notch fa-spin"/> …
                </div>
            </t>
        </div>
    </t>

</templates>
