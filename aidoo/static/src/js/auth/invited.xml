<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aidoo.Invited">
        <div class="o-aidoo-empty p-3 text-center">
            <div class="o-aidoo-empty-icon mb-2">
                <i class="fa fa-envelope-o fa-3x text-muted"/>
            </div>
            <h5 t-esc="labels.title"/>
            <p class="text-muted small">
                <t t-if="props.email">
                    <strong t-esc="props.email"/>
                    <span class="ms-1" t-esc="labels.withEmail"/>
                </t>
                <t t-else="">
                    <t t-esc="labels.withoutEmail"/>
                </t>
            </p>
            <a t-att-href="signupUrl"
               target="_blank" rel="noopener"
               class="btn btn-primary btn-sm"
               t-esc="labels.cta"/>
        </div>
    </t>

</templates>
